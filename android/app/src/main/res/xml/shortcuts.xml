<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
           xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability android:name="actions.intent.CREATE_ITEM_LIST_ITEM">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pvkslabs.listmate"
            android:targetClass="com.pvkslabs.listmate.MainActivity">
            
            <parameter
                android:name="listItem.name"
                android:key="itemName" />
            <parameter
                android:name="itemList.name"
                android:key="listName" />
                
            <!-- We will capture the data in the intent extras -->
        </intent>
    </capability>
    
    <!-- Fallback if Assistant maps to CREATE_THING -->
    <capability android:name="actions.intent.CREATE_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pvkslabs.listmate"
            android:targetClass="com.pvkslabs.listmate.MainActivity">
            
            <parameter
                android:name="thing.name"
                android:key="itemName" />
        </intent>
    </capability>
</shortcuts>
