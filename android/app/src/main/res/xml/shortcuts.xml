<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
           xmlns:app="http://schemas.android.com/apk/res-auto">
    <capability android:name="actions.intent.CREATE_ITEM_LIST_ITEM">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pvkslabs.listmate"
            android:targetClass="com.pvkslabs.listmate.MainActivity">
            <url-template android:value="listmate://assistant/add{?itemName,listName}" />
            <parameter
                android:name="listItem.name"
                android:key="itemName" />
            <parameter
                android:name="itemList.name"
                android:key="listName" />
        </intent>
    </capability>

    <capability android:name="actions.intent.CREATE_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pvkslabs.listmate"
            android:targetClass="com.pvkslabs.listmate.MainActivity">
            <url-template android:value="listmate://assistant/add{?itemName}" />
            <parameter
                android:name="thing.name"
                android:key="itemName" />
        </intent>
    </capability>

    <capability android:name="actions.intent.CREATE_NOTE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pvkslabs.listmate"
            android:targetClass="com.pvkslabs.listmate.MainActivity">
            <url-template android:value="listmate://assistant/add{?itemName}" />
            <parameter
                android:name="note.text"
                android:key="itemName" />
        </intent>
    </capability>
</shortcuts>