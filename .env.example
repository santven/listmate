# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://postgres:postgres@localhost:5432/listmate)
DATABASE_URL=

# REVENUECAT_PUBLIC_KEY: RevenueCat Google Play / App Store public SDK key (starts with goog_ or appl_).
REVENUECAT_PUBLIC_KEY=

# REVENUECAT_WEBHOOK_SECRET: Optional secret token to secure RevenueCat webhooks
REVENUECAT_WEBHOOK_SECRET=

# SENDGRID_API_KEY: Required for sending transactional & cron emails via SendGrid
SENDGRID_API_KEY=

# SENDGRID_WEBHOOK_VERIFICATION_KEY: ECDSA public key for SendGrid Signed Event Webhook verification
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# SENDGRID_WEBHOOK_SECRET: Optional secret token for SendGrid webhook authentication
SENDGRID_WEBHOOK_SECRET=

# SENDGRID_FROM: Verified sender email in SendGrid (defaults to hello@grocerlist.app)
SENDGRID_FROM=

# SENDGRID_FROM_NAME: Sender name displayed in emails (defaults to Listmate)
SENDGRID_FROM_NAME=

# STRIPE_SECRET_KEY: Required for native Stripe web checkout
STRIPE_SECRET_KEY=

# STRIPE_PRICE_MONTHLY: Stripe price ID for the monthly plan (e.g. price_1N...)
STRIPE_PRICE_MONTHLY=

# STRIPE_PRICE_YEARLY: Stripe price ID for the yearly plan (e.g. price_1N...)
STRIPE_PRICE_YEARLY=

# REVENUECAT_WEB_BILLING_MONTHLY_URL: Hosted RevenueCat Web Billing URL for monthly plan
REVENUECAT_WEB_BILLING_MONTHLY_URL=

# REVENUECAT_WEB_BILLING_YEARLY_URL: Hosted RevenueCat Web Billing URL for yearly plan
REVENUECAT_WEB_BILLING_YEARLY_URL=

# Customization
EARLY_ADOPTER_LIMIT=25
FREE_TIER_MEMBER_LIMIT=1
GEMINI_MODEL_NAME=gemini-3.1-flash-lite,gemini-flash-latest
TRIAL_PERIOD_DAYS=30
WEEKLY_RECIPE_LIMIT=7
PROD_DATABASE_URL=
